<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         stopOnFailure="false">
    <testsuites>
        <testsuite name="ElementorDocument">
            <file>tests/ElementorDocumentTest.php</file>
        </testsuite>
        <testsuite name="Snapshots">
            <file>tests/SnapshotsTest.php</file>
        </testsuite>
        <testsuite name="AllyAutoFix">
            <file>tests/AllyAutoFixTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>includes</directory>
        </include>
    </source>
</phpunit>
